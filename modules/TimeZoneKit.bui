    Private Shared Property mAbbreviations As Array Of String = String.Split("LMT|GMT|+0230|EAT|+0245|PMT|WET|WEST|CET|CEST|+0030|WAT|-01|CAT|EET|EEST|+00|+01|SAST|CAST|MMT|WAST|+0130|NST|NWT|NPT|BST|BDT|AHST|HST|HDT|AST|AWT|APT|AHDT|YST|AKST|AKDT|-03|-02|CMT|-04|AMT|EST|MST|CST|MDT|CDT|ADT|-0330|-0530|CWT|CPT|BMT|-05|PST|PDT|MWT|MPT|-00|EDT|-0430|SJMT|SMT|YDT|YWT|YPT|YDDT|PWT|PPT|EWT|EPT|NDT|ADDT|KMT|QMT|-0345|HMT|FFMT|-0230|-0130|PPMT|SDMT|NDDT|+08|+11|+07|+05|PMMT|+10|AEST|AEDT|+06|NZMT|NZST|NZDT|+03|+02|CEMT|+12|+13|+14|+04|+0730|+0820|+09|IST|+0630|+0530|IDT|PLMT|HKT|HKST|HKWT|JST|IMT|+0720|WIB|+0930|WIT|JMT|IDDT|+0430|PKT|PKST|+0545|WITA|KST|RMT|KDT|TBMT|TMT|+0330|JDT|FMT|ACST|ACDT|+0845|+0945|+1030|+1130|AWST|AWDT|EMT|-07|-06|DMT|-10|-11|-12|-08|-09|UTC|BDST|MSK|MSD|WEMT|MDST|LST|WMT|HWT|HPT|+1215|+1245|+1345|-1130|GST|GDT|ChST|-1040|-0930|SST|-1120|+1112|+1230|-0830|-1030|+1220", "|")
