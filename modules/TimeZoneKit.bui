    Public Shared Function Names() As Array Of String
        Dim names() As String
        For Each row As String In mNames
            Array.Append(names, String.Split(row, ",")(0))
        Next
        Return names
    End Function

    Public Shared Function Find(name As String) As String
        Dim rows As Array Of String = mNames
        Dim low As Integer = 0
        Dim high As Integer = Array.Count(mNames) - 1
        While low <= high
            Dim middle As Integer = (low + high) \ 2
            Dim parts As Array Of String = String.Split(rows(middle), ",")
            Dim comparison As Integer = String.Compare(name, parts(0), True)
            If comparison = 0 Then Return rows(middle)
            If comparison < 0 Then
                high = middle - 1
            Else
                low = middle + 1
            End If
        End While
        Throw New InvalidArgumentException("Unknown IANA timezone: " + name)
    End Function

    Public Shared Function ReadUnsigned(row As Integer, field As Integer, width As Integer) As Integer
        Dim decoded As Integer = 0
        Dim factor As Integer = 1
        For i As Integer = 0 To width - 1
            decoded += mRows.Item(row * 17 + field + i) * factor
            factor *= 256
        Next
        Return decoded
    End Function

    Public Shared Function Instant(row As Integer) As Integer
        ' Signed 64-bit seconds stored as two words, avoiding signed shifts/overflow.
        Dim low As Integer = ZoneTables.ReadUnsigned(row, 0, 4)
        Dim high As Integer = ZoneTables.ReadUnsigned(row, 4, 4)
        If high >= 2147483648 Then high -= 4294967296
        Return high * 4294967296 + low
    End Function

    Public Shared Function Offset(row As Integer) As Integer
        Dim value As Integer = ZoneTables.ReadUnsigned(row, 8, 4)
        If value >= 2147483648 Then value -= 4294967296
        Return value
    End Function

    Public Shared Function Abbreviation(row As Integer) As String
        Dim abbreviations As Array Of String = mAbbreviations
        Return abbreviations(ZoneTables.ReadUnsigned(row, 12, 4))
    End Function

    Public Shared Function IsDST(row As Integer) As Boolean
        Return mRows.Item(row * 17 + 16) <> 0
    End Function
End Class

Private Function ZoneDaysBeforeYear(year As Integer) As Integer
    Dim previousYear As Integer = year - 1
    Return previousYear * 365 + previousYear \ 4 - previousYear \ 100 + previousYear \ 400
End Function

Private Function ZoneMonthDays(year As Integer, month As Integer) As Integer
    Select Case month
        Case 4, 6, 9, 11
            Return 30
        Case 2
            If year Mod 4 = 0 And (year Mod 100 <> 0 Or year Mod 400 = 0) Then Return 29
            Return 28
        Case Else
            Return 31
    End Select
End Function

Private Function ZoneLocalMillis(year As Integer, month As Integer, day As Integer, hour As Integer, minute As Integer, second As Integer, millisecond As Integer) As Integer
    If year < 1 Or year > 9999 Or month < 1 Or month > 12 Then Throw New InvalidArgumentException("Invalid Gregorian year or month")
    If day < 1 Or day > ZoneMonthDays(year, month) Then Throw New InvalidArgumentException("Invalid Gregorian day")
    If hour < 0 Or hour > 23 Or minute < 0 Or minute > 59 Or second < 0 Or second > 59 Or millisecond < 0 Or millisecond > 999 Then Throw New InvalidArgumentException("Invalid local clock components")
    Dim days As Integer = ZoneDaysBeforeYear(year) + day - 1
    For selectedMonth As Integer = 1 To month - 1
        days += ZoneMonthDays(year, selectedMonth)
    Next
    Return (days - 719162) * 86400000 + hour * 3600000 + minute * 60000 + second * 1000 + millisecond
End Function

Private Function ZoneDigits(value As Integer, width As Integer) As String
    Return String.Right("0000" + Str(value), width)
End Function

''' An instant and its portable named-zone presentation. All properties are read-only.
Public Class ZonedDateTime
    Private Property mInstant As DateTime
    Private Property mYear As Integer
    Private Property mMonth As Integer
    Private Property mDay As Integer
    Private Property mHour As Integer
    Private Property mMinute As Integer
    Private Property mSecond As Integer
    Private Property mMillisecond As Integer
    Private Property mName As String
    Private Property mOffset As Integer
    Private Property mAbbreviation As String
    Private Property mDST As Boolean

    Internal Sub Constructor(instant As DateTime, name As String, offset As Integer, abbreviation As String, dst As Boolean)
        If instant = Nil Then Throw New InvalidArgumentException("instant is required")
        mInstant = instant.ToUtc()
        Dim localMillis As Integer = instant.MillisFrom1970 + offset * 1000
        Dim days As Integer = localMillis \ 86400000
        Dim clock As Integer = localMillis Mod 86400000
        If clock < 0 Then
            clock += 86400000
            days -= 1
        End If
        Dim ordinal As Integer = days + 719162
        Dim low As Integer = 1
        Dim high As Integer = 10000
        While low + 1 < high
            Dim middle As Integer = (low + high) \ 2
            If ZoneDaysBeforeYear(middle) <= ordinal Then
                low = middle
            Else
                high = middle
            End If
        End While
        mYear = low
        Dim dayOfYear As Integer = ordinal - ZoneDaysBeforeYear(mYear)
        mMonth = 1
        While dayOfYear >= ZoneMonthDays(mYear, mMonth)
            dayOfYear -= ZoneMonthDays(mYear, mMonth)
            mMonth += 1
        End While
        mDay = dayOfYear + 1
        mHour = clock \ 3600000
        mMinute = (clock Mod 3600000) \ 60000
        mSecond = (clock Mod 60000) \ 1000
        mMillisecond = clock Mod 1000
        mName = name
        mOffset = offset
        mAbbreviation = abbreviation
        mDST = dst
    End Sub

    Public Property Instant As DateTime
        Get
            Return mInstant
        End Get
    End Property
    Public Property ZoneName As String
        Get
            Return mName
        End Get
    End Property
    Public Property OffsetSeconds As Integer
        Get
            Return mOffset
        End Get
    End Property
    Public Property Abbreviation As String
        Get
            Return mAbbreviation
        End Get
    End Property
    Public Property IsDST As Boolean
        Get
            Return mDST
        End Get
    End Property
    Public Property Year As Integer
        Get
            Return mYear
        End Get
    End Property
    Public Property Month As Integer
        Get
            Return mMonth
        End Get
    End Property
    Public Property Day As Integer
        Get
            Return mDay
        End Get
    End Property
    Public Property Hour As Integer
        Get
            Return mHour
        End Get
    End Property
    Public Property Minute As Integer
        Get
            Return mMinute
        End Get
    End Property
    Public Property Second As Integer
        Get
            Return mSecond
        End Get
    End Property
    Public Property Millisecond As Integer
        Get
            Return mMillisecond
        End Get
    End Property

    Public Function ToISO8601() As String
        Dim localText As String = ZoneDigits(mYear, 4) + "-" + ZoneDigits(mMonth, 2) + "-" + ZoneDigits(mDay, 2) + "T" + ZoneDigits(mHour, 2) + ":" + ZoneDigits(mMinute, 2) + ":" + ZoneDigits(mSecond, 2) + "." + ZoneDigits(mMillisecond, 3)
        Dim offset As Integer = mOffset
        Dim sign As String = "+"
        If offset < 0 Then
            sign = "-"
            offset = -offset
        End If
        Dim hours As String = String.Right("0" + Str(offset \ 3600), 2)
        Dim minutes As String = String.Right("0" + Str((offset Mod 3600) \ 60), 2)
        Dim seconds As String = ""
        If offset Mod 60 <> 0 Then seconds = ":" + String.Right("0" + Str(offset Mod 60), 2)
        Return localText + sign + hours + ":" + minutes + seconds
    End Function
End Class

''' Named-zone lookups for instants in UTC years 1800 through 2500.
Public Class NamedTimeZone
    Private Property mName As String
    Private Property mStart As Integer
    Private Property mCount As Integer

    Public Sub Constructor(name As String)
        Dim fields As Array Of String = String.Split(ZoneTables.Find(name), ",")
        mName = fields(0)
        mStart = Integer.Parse(fields(1)).Value
        mCount = Integer.Parse(fields(2)).Value
    End Sub

    Public Property Name As String
        Get
            Return mName
        End Get
    End Property

    Public Function At(instant As DateTime) As ZonedDateTime
        If instant = Nil Then Throw New InvalidArgumentException("instant is required")
        Dim millis As Integer = instant.MillisFrom1970
        If millis < -5364662400000 Or millis >= 16756761600000 Then Throw New InvalidArgumentException("Timezone instant must be in UTC years 1800..2500")
        Dim low As Integer = mStart
        Dim high As Integer = mStart + mCount
        While low + 1 < high
            Dim middle As Integer = (low + high) \ 2
            If ZoneTables.Instant(middle) * 1000 <= millis Then
                low = middle
            Else
                high = middle
            End If
        End While
        Return New ZonedDateTime(instant, mName, ZoneTables.Offset(low), ZoneTables.Abbreviation(low), ZoneTables.IsDST(low))
    End Function

    ''' Resolve a wall-clock time; reject gaps, and choose reject/earlier/later for overlaps.
    Public Function ResolveLocal(year As Integer, month As Integer, day As Integer, hour As Integer = 0, minute As Integer = 0, second As Integer = 0, millisecond As Integer = 0, ambiguity As String = "reject") As ZonedDateTime
        If ambiguity <> "reject" And ambiguity <> "earlier" And ambiguity <> "later" Then Throw New InvalidArgumentException("ambiguity must be reject, earlier or later")
        Dim wallMillis As Integer = ZoneLocalMillis(year, month, day, hour, minute, second, millisecond)
        Dim offsets As New Set Of Integer()
        For i As Integer = mStart To mStart + mCount - 1
            offsets.Add(ZoneTables.Offset(i))
        Next
        Dim first As ZonedDateTime = Nil
        Dim last As ZonedDateTime = Nil
        Dim count As Integer = 0
        For Each offset As Integer In offsets
            Dim millis As Integer = wallMillis - offset * 1000
            If millis < -5364662400000 Or millis >= 16756761600000 Then Continue For
            Dim candidate As ZonedDateTime = Me.At(DateTime.FromUnixMillis(millis, TimeZone.Utc))
            If candidate.OffsetSeconds = offset Then
                count += 1
                If first = Nil Then
                    first = candidate
                    last = candidate
                Else
                    If millis < first.Instant.MillisFrom1970 Then first = candidate
                    If millis > last.Instant.MillisFrom1970 Then last = candidate
                End If
            End If
        Next
        If count = 0 Then Throw New InvalidArgumentException("Local time is in a timezone gap or outside the supported range")
        If count > 1 And ambiguity = "reject" Then Throw New InvalidArgumentException("Local time is ambiguous; choose earlier or later")
        If ambiguity = "later" Then Return last
        Return first
    End Function
End Class

''' Return an owned list of accepted IANA names and aliases in ordinal order.
Public Function NamedTimeZones() As Array Of String
    Return ZoneTables.Names()
End Function

''' Version of the pinned CLDR Windows-to-IANA mapping data.
Public Function WindowsZoneMappingVersion() As String
    Return "49"
End Function

